# Copy to deploy/.env and fill in. Never commit the real file.

# Your site's address with no https://, e.g. app.example.com. Its DNS A record must point at this server.
DOMAIN=app.example.com

# A long random password for the database, e.g. from:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Outgoing email (password reset). Get these from your email provider (Postmark, Resend, Mailgun, SES, Brevo...).
# smtps://USER:PASSWORD@HOST       port 465, encrypted from the start
# smtp://USER:PASSWORD@HOST:587    port 587, upgraded to encryption (required)
# Special characters in the user or password must be URL-encoded (@ becomes %40).
SMTP_URL=
# The sender address. It must be on a domain you have verified with your email provider.
MAIL_FROM="IronTrack <no-reply@example.com>"

# Optional: run athletes' plans from Google Sheets. Paste the service account key as ONE line inside single quotes
# (see "Google Sheets" in README.md). Leave empty to switch the feature off.
GOOGLE_SERVICE_ACCOUNT_JSON=
